# Get a key from https://dashboard.sarvam.ai
SARVAM_API_KEY=

PORT=8787

# Optional overrides (defaults shown)
# LLM_MODEL=sarvam-105b
# LLM_REASONING_EFFORT=off   # off | low | medium | high
# STT_MODEL=saaras:v3
# STT_MODE=transcribe
# TTS_MODEL=bulbul:v3
# TTS_SPEAKER=shubh
# CALL_SILENCE_MS=600            # silence before Sarvam VAD ends speech
# CALL_HOLD_QUESTION_MS=200      # extra wait if it ends with "?"
# CALL_HOLD_SENTENCE_MS=500      # extra wait if it ends with "." or "!"
# CALL_HOLD_INCOMPLETE_MS=1500   # extra wait if it trails off ("and", "um", no punctuation)
